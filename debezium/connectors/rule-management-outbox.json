{
  "name": "paypulse-rule-management-outbox",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "postgres",
    "database.dbname": "paypulse",
    "topic.prefix": "cdc.paypulse.rule.outbox",
    "plugin.name": "pgoutput",
    "slot.name": "paypulse_rule_outbox",
    "publication.name": "paypulse_rule_outbox_pub",
    "publication.autocreate.mode": "filtered",
    "table.include.list": "rule_management.outbox",
    "heartbeat.interval.ms": "10000",
    "tombstones.on.delete": "false",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "partitioning_key",
    "transforms.outbox.table.field.event.type": "type",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.route.by.field": "type",
    "transforms.outbox.route.topic.regex": "FraudRuleUpdated",
    "transforms.outbox.route.topic.replacement": "fraud_rules",
    "transforms.outbox.route.tombstone.on.empty.payload": "false"
  }
}
