{
  "uid": "paypulse-kafka-health",
  "title": "PayPulse Kafka Health",
  "tags": ["paypulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer group lag",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kafka_consumergroup_lag) by (consumergroup)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DLT messages",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(paypulse_dlt_messages_total[5m])) by (topic)", "refId": "A" }]
    }
  ]
}
