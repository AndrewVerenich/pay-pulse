{
  "uid": "paypulse-saga-state",
  "title": "PayPulse Saga State",
  "tags": ["paypulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active sagas",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(saga_active_count) by (saga_type)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Saga outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(saga_completed_total[5m])) by (outcome)", "refId": "A" }]
    }
  ]
}
