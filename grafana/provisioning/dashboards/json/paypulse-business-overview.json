{
  "uid": "paypulse-business-overview",
  "title": "PayPulse Business Overview",
  "tags": ["paypulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Payment TPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(paypulse_payments_total[1m]))", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Fraud alerts rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(paypulse_fraud_alerts_total[5m]))", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Saga duration p95",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(paypulse_saga_duration_seconds_bucket[5m])) by (le))", "refId": "A" }]
    }
  ]
}
