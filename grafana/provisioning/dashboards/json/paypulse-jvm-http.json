{
  "uid": "paypulse-jvm-http",
  "title": "PayPulse JVM & HTTP",
  "tags": ["paypulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (service)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP server requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (service)", "refId": "A" }]
    }
  ]
}
